      "cuisine": "italian",
      "diet_tags": [
        "vegan",
        "dairy_free",
        "nut_free"
      ],
      "prep_minutes": 10,
      "cook_minutes": 15,
      "servings": 4,
      "ingredients": [
        {
          "name": "Spaghetti",
          "quantity": 400,
          "unit": "g",

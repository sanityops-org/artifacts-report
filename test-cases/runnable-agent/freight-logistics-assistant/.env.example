# LLM Configuration (copy to .env and fill in real values)
# Provider: anthropic or openai
LLM_PROVIDER=anthropic

# API Key (required - run.py will exit if not configured)
LLM_API_KEY=your-api-key

# Model ID (optional - leave empty to use SDK default)
LLM_MODEL_ID=

# Custom API endpoint (optional - for private gateway)
LLM_BASE_URL=
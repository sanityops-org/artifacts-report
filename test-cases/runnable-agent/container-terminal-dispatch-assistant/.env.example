# Container Terminal Dispatch Assistant - Environmental Configuration
# Copy this file as .env and fill in the actual value

# ============== LLM Provider Deploy ==============
# LLM_PROVIDER: Choose "anthropic" or "openai"
LLM_PROVIDER=anthropic

# API Key（Required)
LLM_API_KEY=your-api-key

# Model ID (optional)
LLM_MODEL_ID=claude-sonnet-5-20250514

# Custom Base URL (optional, for proxy or private deployment)
# LLM_BASE_URL=https://api.anthropic.com

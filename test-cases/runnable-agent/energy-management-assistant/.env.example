# LLM Configuration
# Copy this file to .env and fill in your values

# Provider: anthropic or openai
LLM_PROVIDER=anthropic

# API Key (required)
LLM_API_KEY=your-api-key-here

# Model ID (optional - uses SDK default if not set)
LLM_MODEL_ID=

# Custom API endpoint (optional - for private gateways)
LLM_BASE_URL=